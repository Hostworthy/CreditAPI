# Bruno end-to-end stack: the real server with the fake Claude CLI
# (bin/fakeclaude). No Claude account or network access is needed.
# Copy to .env.bruno, then run `make e2e` and use the Bruno app or `make bruno`.
HOST=127.0.0.1
PORT=18180
PUBLIC_URL=http://127.0.0.1:18180
DATA_DIR=./data/bruno
ADMIN_PASSWORD=bruno-admin-password
CLAUDE_BIN=./bin/fakeclaude
DEFAULT_MODEL=sonnet
MODELS=opus,sonnet,haiku
MODEL_ALIASES=gpt-4o=opus
MAX_CONCURRENT=2
QUEUE_TIMEOUT=30s
REQUEST_TIMEOUT=60s
LOG_LEVEL=warn
