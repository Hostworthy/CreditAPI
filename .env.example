# Copy to .env and adjust. Only ADMIN_PASSWORD is required.

# Protects /admin and /login (min 8 characters).
ADMIN_PASSWORD=change-me-to-something-long

# Listen address for local runs (the Docker image uses 0.0.0.0:8080).
# HOST=127.0.0.1
# PORT=8080

# The address you open in your browser. Used for the login link that apps
# show when a subscription's login needs renewing.
# PUBLIC_URL=https://ai.example.com

# Only behind a reverse proxy: addresses or CIDR ranges whose X-Forwarded-*
# headers are believed. See examples/nginx.conf.
# TRUSTED_PROXIES=

# Subscriptions (Claude and Cursor accounts) and which keys may use them are
# managed on /admin. The settings below apply to all subscriptions of a kind.

# Claude: model used when a request names no model Claude knows (e.g. "gpt-4o").
# Aliases: opus, sonnet, haiku. Full model names also work.
DEFAULT_MODEL=sonnet
# Claude models listed by GET /v1/models.
MODELS=opus,sonnet,haiku

# Cursor: model names Cursor subscriptions accept, and the default one.
# CURSOR_MODELS=auto
# CURSOR_DEFAULT_MODEL=auto

# Optional explicit mapping, e.g. for clients with hard-coded model names.
# MODEL_ALIASES=gpt-4o=sonnet,gpt-4o-mini=haiku
# Reject model names no subscription of the key accepts, instead of using each
# subscription's default model.
# STRICT_MODELS=false

# Reasoning effort when the client does not send reasoning_effort:
# low, medium, high, xhigh or max (empty = Claude Code default).
# DEFAULT_EFFORT=

# How many CLI processes may run at once (all subscriptions together), and how
# long requests wait for a slot.
MAX_CONCURRENT=2
# Requests admitted at once (running plus waiting); default 4 x MAX_CONCURRENT.
# MAX_PENDING=8
# QUEUE_TIMEOUT=2m
# REQUEST_TIMEOUT=10m

# System prompt used when the client sends none.
# DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Images: longest side is scaled down to this many pixels (0 = never resize).
# IMAGE_MAX_DIMENSION=1568
# Refuse images larger than this many pixels (protects memory).
# IMAGE_MAX_PIXELS=40000000
# MAX_IMAGES=20
# Allow image_url values that are http(s) links (fetched by this server).
# ALLOW_IMAGE_URLS=true
# Also allow links to private/LAN addresses (off by default to prevent SSRF).
# ALLOW_PRIVATE_IMAGE_URLS=false
# MAX_BODY_MB=50

# Optional: a long-lived token from `claude setup-token` for the "Claude"
# subscription created on the first start. A login done at /login takes
# precedence, so you can leave this empty and sign in from your phone.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: a Cursor API key. When set on the first start, a "Cursor"
# subscription is created that uses it.
# CURSOR_API_KEY=

# LOG_LEVEL=info
