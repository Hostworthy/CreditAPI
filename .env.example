# Copy to .env and adjust. Only ADMIN_PASSWORD is required.

# Protects /admin and /login (min 8 characters).
ADMIN_PASSWORD=change-me-to-something-long

# Model used when a client asks for an unknown model (e.g. "gpt-4o").
# Aliases: opus, sonnet, haiku. Full model names also work.
DEFAULT_MODEL=sonnet
# Models listed by GET /v1/models.
MODELS=opus,sonnet,haiku
# Optional explicit mapping, e.g. for clients with hard-coded model names.
# MODEL_ALIASES=gpt-4o=sonnet,gpt-4o-mini=haiku
# Reject unknown model names instead of using DEFAULT_MODEL.
# STRICT_MODELS=false

# Reasoning effort when the client does not send reasoning_effort:
# low, medium, high, xhigh or max (empty = Claude Code default).
# DEFAULT_EFFORT=

# How many claude processes may run at once, and how long requests wait for a slot.
MAX_CONCURRENT=2
# QUEUE_TIMEOUT=2m
# REQUEST_TIMEOUT=10m

# System prompt used when the client sends none.
# DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Images: longest side is scaled down to this many pixels (0 = never resize).
# IMAGE_MAX_DIMENSION=1568
# MAX_IMAGES=20
# Allow image_url values that are http(s) links (fetched by this server).
# ALLOW_IMAGE_URLS=true
# Also allow links to private/LAN addresses (off by default to prevent SSRF).
# ALLOW_PRIVATE_IMAGE_URLS=false
# MAX_BODY_MB=50

# Optional MCP servers Claude may call itself (file mounted into the container).
# MCP_CONFIG=/config/mcp.json
# MAX_TURNS=10

# Optional: a long-lived token from `claude setup-token`. A login done at /login
# takes precedence, so you can leave this empty and sign in from your phone.
# CLAUDE_CODE_OAUTH_TOKEN=

# LOG_LEVEL=info
