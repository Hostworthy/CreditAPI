meta {
  name: Login page
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/login
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("sign-in page with a subscription picker", function () {
    expect(res.body).to.contain("sub-select");
    expect(res.headers["referrer-policy"]).to.equal("no-referrer");
  });
}
