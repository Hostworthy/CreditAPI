meta {
  name: Admin page
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("HTML with a strict CSP", function () {
    expect(res.headers["content-type"]).to.contain("text/html");
    expect(res.headers["content-security-policy"]).to.contain("script-src 'self'");
    expect(res.headers["x-frame-options"]).to.equal("DENY");
    expect(res.body).to.contain("Virtual API keys");
  });
}
