meta {
  name: Large photo is resized
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "What is in this picture?"
          },
          {
            "type": "image_url",
            "image_url": {
              "url": "data:image/png;base64,"
            }
          }
        ]
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("a 2000x400 photo reaches Claude as a 1568px JPEG", function () {
    expect(res.body.choices[0].message.content).to.equal("I see 1 image(s): image/jpeg 1568x313. Fake reply to: What is in this picture?");
  });
}
