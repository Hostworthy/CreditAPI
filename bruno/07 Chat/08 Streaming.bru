meta {
  name: Streaming
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "Stream a short answer"
      }
    ],
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  }
}

assert {
  res.status: eq 200
}

tests {
  function sse(res) {
    const raw = typeof res.body === "string" ? res.body : JSON.stringify(res.body);
    const data = raw.split("\n").filter((l) => l.startsWith("data: ")).map((l) => l.slice(6));
    return { done: data.includes("[DONE]"), chunks: data.filter((d) => d !== "[DONE]").map((d) => JSON.parse(d)) };
  }

  const { done, chunks } = sse(res);
  test("server-sent events", function () {
    expect(res.headers["content-type"]).to.contain("text/event-stream");
    expect(done).to.equal(true);
  });
  test("chunks assemble the reply", function () {
    const text = chunks.flatMap((c) => c.choices).map((c) => (c.delta && c.delta.content) || "").join("");
    expect(text).to.equal("Fake reply to: Stream a short answer");
    expect(chunks[0].choices[0].delta.role).to.equal("assistant");
    expect(chunks.every((c) => c.object === "chat.completion.chunk")).to.equal(true);
  });
  test("ends with finish_reason and usage", function () {
    const finish = chunks.flatMap((c) => c.choices).map((c) => c.finish_reason).filter(Boolean);
    expect(finish).to.deep.equal(["stop"]);
    expect(chunks[chunks.length - 1].usage.total_tokens).to.be.above(0);
  });
}
