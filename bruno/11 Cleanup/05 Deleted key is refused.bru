meta {
  name: Deleted key is refused
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.status: eq 401
}

tests {
  test("invalid_api_key", function () {
    expect(res.body.error.code).to.equal("invalid_api_key");
  });
}
