meta {
  name: Requests need a login again
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "hi"
      }
    ]
  }
}

assert {
  res.status: eq 401
}

tests {
  test("subscription_login_required", function () {
    expect(res.body.error.code).to.equal("subscription_login_required");
  });
}
