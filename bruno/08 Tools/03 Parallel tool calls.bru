meta {
  name: Parallel tool calls
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "add_task",
          "description": "Add a task to the to-do list",
          "parameters": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "hours": {
                "type": "number"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_agenda",
          "description": "Calendar events for a day",
          "parameters": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "use add_task and get_agenda"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("two calls in one reply", function () {
    expect(res.body.choices[0].message.tool_calls.map((c) => c.function.name)).to.deep.equal(["add_task", "get_agenda"]);
  });
}
