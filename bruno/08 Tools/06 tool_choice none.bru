meta {
  name: tool_choice none
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "log_food",
          "description": "Log a food entry to the diary",
          "parameters": {
            "type": "object",
            "required": [
              "food_name"
            ],
            "properties": {
              "food_name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "meal_type": {
                "type": "string",
                "enum": [
                  "breakfast",
                  "lunch",
                  "dinner",
                  "snacks"
                ]
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_daily_summary",
          "description": "Calories and macros for a day",
          "parameters": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    ],
    "tool_choice": "none",
    "messages": [
      {
        "role": "user",
        "content": "just chat"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("plain text answer", function () {
    expect(res.body.choices[0].finish_reason).to.equal("stop");
    expect(res.body.choices[0].message.content).to.equal("Fake reply to: just chat");
  });
}
