meta {
  name: Named tool_choice
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "add_task",
          "description": "Add a task to the to-do list",
          "parameters": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "hours": {
                "type": "number"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_agenda",
          "description": "Calendar events for a day",
          "parameters": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    ],
    "tool_choice": {
      "type": "function",
      "function": {
        "name": "get_agenda"
      }
    },
    "messages": [
      {
        "role": "user",
        "content": "what is on my calendar today?"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("calls the named tool", function () {
    const fn = res.body.choices[0].message.tool_calls[0].function;
    expect(fn.name).to.equal("get_agenda");
    expect(JSON.parse(fn.arguments)).to.deep.equal({ date: "2026-01-01" });
  });
}
