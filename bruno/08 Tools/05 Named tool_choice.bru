meta {
  name: Named tool_choice
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "log_food",
          "description": "Log a food entry to the diary",
          "parameters": {
            "type": "object",
            "required": [
              "food_name"
            ],
            "properties": {
              "food_name": {
                "type": "string"
              },
              "quantity": {
                "type": "number"
              },
              "meal_type": {
                "type": "string",
                "enum": [
                  "breakfast",
                  "lunch",
                  "dinner",
                  "snacks"
                ]
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_daily_summary",
          "description": "Calories and macros for a day",
          "parameters": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    ],
    "tool_choice": {
      "type": "function",
      "function": {
        "name": "get_daily_summary"
      }
    },
    "messages": [
      {
        "role": "user",
        "content": "how am I doing today?"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("calls the named tool", function () {
    const fn = res.body.choices[0].message.tool_calls[0].function;
    expect(fn.name).to.equal("get_daily_summary");
    expect(JSON.parse(fn.arguments)).to.deep.equal({ date: "2026-01-01" });
  });
}
