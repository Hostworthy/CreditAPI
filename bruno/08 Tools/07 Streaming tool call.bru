meta {
  name: Streaming tool call
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "stream": true,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "add_task",
          "description": "Add a task to the to-do list",
          "parameters": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "hours": {
                "type": "number"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "urgent"
                ]
              }
            }
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "get_agenda",
          "description": "Calendar events for a day",
          "parameters": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    ],
    "messages": [
      {
        "role": "user",
        "content": "remind me to water the plants"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  function sse(res) {
    const raw = typeof res.body === "string" ? res.body : JSON.stringify(res.body);
    const data = raw.split("\n").filter((l) => l.startsWith("data: ")).map((l) => l.slice(6));
    return { done: data.includes("[DONE]"), chunks: data.filter((d) => d !== "[DONE]").map((d) => JSON.parse(d)) };
  }

  const { done, chunks } = sse(res);
  const deltas = chunks.flatMap((c) => c.choices).flatMap((c) => (c.delta && c.delta.tool_calls) || []);
  test("tool call streamed in OpenAI delta format", function () {
    expect(done).to.equal(true);
    expect(deltas[0].id).to.match(/^call_/);
    expect(deltas[0].function.name).to.equal("add_task");
    const args = deltas.map((d) => d.function.arguments).join("");
    expect(JSON.parse(args).title).to.equal("fake title");
  });
  test("finish_reason is tool_calls", function () {
    const finish = chunks.flatMap((c) => c.choices).map((c) => c.finish_reason).filter(Boolean);
    expect(finish).to.deep.equal(["tool_calls"]);
  });
}
