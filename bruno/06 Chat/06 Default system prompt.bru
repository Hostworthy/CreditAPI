meta {
  name: Default system prompt
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "[fake:echo-system]"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("DEFAULT_SYSTEM_PROMPT applies", function () {
    expect(res.body.choices[0].message.content).to.equal("You are a helpful assistant.");
  });
}
