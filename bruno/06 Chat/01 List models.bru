meta {
  name: List models
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/models
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("OpenAI model list", function () {
    expect(res.body.object).to.equal("list");
    const ids = res.body.data.map((m) => m.id);
    expect(ids).to.include.members(["sonnet", "opus", "haiku", "gpt-4o"]);
  });
}
