meta {
  name: Get model
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/models/haiku
  body: none
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

assert {
  res.status: eq 200
}

tests {
  test("model object", function () {
    expect(res.body.id).to.equal("haiku");
    expect(res.body.object).to.equal("model");
  });
}
