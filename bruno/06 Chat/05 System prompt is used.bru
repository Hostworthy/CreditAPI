meta {
  name: System prompt is used
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "messages": [
      {
        "role": "system",
        "content": "You are a nutrition assistant."
      },
      {
        "role": "user",
        "content": "[fake:echo-system]"
      }
    ]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Claude received the client's system prompt", function () {
    expect(res.body.choices[0].message.content).to.equal("You are a nutrition assistant.");
  });
}
