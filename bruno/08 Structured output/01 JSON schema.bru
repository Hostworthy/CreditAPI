meta {
  name: JSON schema
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "Read this nutrition label"
      }
    ],
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "label",
        "strict": true,
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "calories",
            "protein_g",
            "serving"
          ],
          "properties": {
            "calories": {
              "type": "number"
            },
            "protein_g": {
              "type": "number"
            },
            "serving": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

assert {
  res.status: eq 200
}

tests {
  test("content is JSON matching the schema", function () {
    const v = JSON.parse(res.body.choices[0].message.content);
    expect(v).to.deep.equal({ calories: 42, protein_g: 42, serving: "fake serving" });
  });
}
