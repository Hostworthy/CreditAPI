meta {
  name: Models
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/models
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
  anthropic-version: 2023-06-01
}

assert {
  res.status: eq 200
}

tests {
  test("anthropic-version switches /v1/models to the Anthropic shape", function () {
    expect(res.body.has_more).to.equal(false);
    expect(res.body.data[0].type).to.equal("model");
    expect(res.body.data.map((m) => m.id)).to.include("haiku");
  });
}
