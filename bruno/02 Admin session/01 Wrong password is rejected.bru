meta {
  name: Wrong password is rejected
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/admin/api/session
  body: json
  auth: none
}

body:json {
  {
    "password": "not-the-password"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("explains the failure", function () {
    expect(res.body.error).to.equal("wrong password");
  });
}
