meta {
  name: Sign in
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/api/session
  body: json
  auth: none
}

body:json {
  {
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("sets a locked-down session cookie", function () {
    const cookie = [].concat(res.headers["set-cookie"]).join(";");
    expect(cookie).to.contain("creditapi_admin=");
    expect(cookie).to.contain("HttpOnly");
    expect(cookie).to.contain("SameSite=Strict");
  });
}
