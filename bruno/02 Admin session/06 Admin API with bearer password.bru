meta {
  name: Admin API with bearer password
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/admin/api/keys
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

assert {
  res.status: eq 200
}

tests {
  test("lists keys", function () {
    expect(res.body.keys).to.be.an("array");
  });
}
