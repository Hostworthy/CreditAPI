meta {
  name: Second request fails fast
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "again"
      }
    ]
  }
}

assert {
  res.status: eq 401
}

tests {
  test("answered without starting claude", function () {
    expect(res.responseTime).to.be.below(500);
  });
}
