meta {
  name: Chat says login required
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "What is the tallest mountain on Earth?"
      }
    ]
  }
}

assert {
  res.status: eq 401
}

tests {
  test("OpenAI authentication_error with our code", function () {
    expect(res.body.error.type).to.equal("authentication_error");
    expect(res.body.error.code).to.equal("subscription_login_required");
  });
  test("message names the subscription and links to its login page", function () {
    expect(res.body.error.message).to.contain(bru.getVar("claudeName") + " is signed out");
    expect(res.body.error.message).to.contain(bru.getEnvVar("baseUrl") + "/login?subscription=" + bru.getVar("claudeId"));
  });
}
