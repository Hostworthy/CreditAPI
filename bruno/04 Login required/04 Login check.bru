meta {
  name: Login check
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/api/claude/check
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

body:json {
  {}
}

assert {
  res.status: eq 200
}

tests {
  test("sign-in required", function () {
    expect(res.body.state).to.equal("login_required");
    expect(res.body.cached).to.equal(false);
    expect(res.body.reason).to.contain("Not logged in");
  });
}
