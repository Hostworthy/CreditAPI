meta {
  name: Health shows login required
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/healthz
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("claude_login is login_required", function () {
    expect(res.body.claude_login).to.equal("login_required");
    expect(res.body.claude_token).to.equal(false);
  });
}
