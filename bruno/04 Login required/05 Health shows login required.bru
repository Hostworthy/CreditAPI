meta {
  name: Health shows login required
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/healthz
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("logins_ok is false and the subscription needs a sign-in", function () {
    expect(res.body.logins_ok).to.equal(false);
    const sub = res.body.subscriptions.find((s) => s.id === bru.getVar("claudeId"));
    expect(sub.login).to.equal("login_required");
  });
}
