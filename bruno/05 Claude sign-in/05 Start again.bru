meta {
  name: Start again
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/api/subscriptions/{{claudeId}}/login
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

assert {
  res.status: eq 200
}

tests {
  test("a new sign-in gets a new link", function () {
    expect(res.body.state).to.equal("waiting_for_code");
    expect(res.body.url).to.not.equal(bru.getVar("firstLoginUrl"));
  });
}
