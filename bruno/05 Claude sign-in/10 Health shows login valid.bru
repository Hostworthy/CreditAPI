meta {
  name: Health shows login valid
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/healthz
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("the subscription is valid", function () {
    const sub = res.body.subscriptions.find((s) => s.id === bru.getVar("claudeId"));
    expect(sub.login).to.equal("valid");
  });
}
