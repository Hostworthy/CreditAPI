meta {
  name: Health shows login valid
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/healthz
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("claude_login is valid", function () {
    expect(res.body.claude_login).to.equal("valid");
    expect(res.body.claude_token).to.equal(true);
  });
}
