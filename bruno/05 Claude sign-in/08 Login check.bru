meta {
  name: Login check
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/admin/api/subscriptions/{{claudeId}}/check
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

body:json {
  {}
}

assert {
  res.status: eq 200
}

tests {
  test("valid, verified with a test prompt", function () {
    expect(res.body.state).to.equal("valid");
    expect(res.body.cached).to.equal(false);
    expect(res.body.source).to.equal("check");
  });
}
