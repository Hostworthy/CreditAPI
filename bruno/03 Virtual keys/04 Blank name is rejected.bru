meta {
  name: Blank name is rejected
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/admin/api/keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

body:json {
  {
    "name": "  "
  }
}

assert {
  res.status: eq 400
}

tests {
  test("explains the problem", function () {
    expect(res.body.error).to.equal("name is required");
  });
}
