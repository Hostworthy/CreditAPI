meta {
  name: JSON mode
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "sonnet",
    "messages": [
      {
        "role": "user",
        "content": "apple"
      }
    ],
    "response_format": {
      "type": "json_object"
    }
  }
}

assert {
  res.status: eq 200
}

tests {
  test("code fences are stripped", function () {
    expect(res.body.choices[0].message.content).to.equal('{"fake":true,"reply":"apple"}');
  });
}
