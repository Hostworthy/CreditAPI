meta {
  name: A disabled subscription cannot be pinned
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{apiKey}}
}

body:json {
  {
    "model": "bruno-cursor/auto",
    "messages": [
      {
        "role": "user",
        "content": "[fake:whoami]"
      }
    ]
  }
}

assert {
  res.status: eq 403
}
