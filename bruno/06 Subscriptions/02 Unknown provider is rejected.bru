meta {
  name: Unknown provider is rejected
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/admin/api/subscriptions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

body:json {
  {
    "name": "Bruno Gemini",
    "provider": "gemini"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("names the providers", function () {
    expect(res.body.error).to.contain("claude, cursor");
  });
}
