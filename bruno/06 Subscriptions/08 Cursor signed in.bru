meta {
  name: Cursor signed in
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/admin/api/subscriptions/{{cursorId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  // The fake sign-in runs in a terminal on the server; wait for it to settle.
  const want = "success";
  for (let i = 0; i < 40; i++) {
    const r = await bru.sendRequest({
      method: "GET",
      url: bru.getEnvVar("baseUrl") + "/admin/api/subscriptions/" + bru.getVar("cursorId"),
      headers: { Authorization: "Bearer " + bru.getEnvVar("adminPassword") },
    });
    const body = r.data || r.body || {};
    if (body.login && body.login.state === want) break;
    await bru.sleep(250);
  }
}

tests {
  test("the fake browser approved the sign-in", function () {
    expect(res.body.login.state).to.equal("success");
    expect(res.body.credential.saved_at).to.be.a("string");
  });
}
