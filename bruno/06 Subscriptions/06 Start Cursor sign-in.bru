meta {
  name: Start Cursor sign-in
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/admin/api/subscriptions/{{cursorId}}/login
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

assert {
  res.status: eq 200
}

tests {
  test("waits for the browser, no code needed", function () {
    expect(res.body.state).to.equal("waiting_for_browser");
    expect(res.body.needs_code).to.equal(false);
    expect(res.body.url).to.match(/^https:\/\/cursor\.com\//);
  });
}
