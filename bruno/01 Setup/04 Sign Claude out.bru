meta {
  name: Sign Claude out
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/admin/api/subscriptions/{{claudeId}}/credential
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminPassword}}
}

assert {
  res.status: eq 200
}

tests {
  test("no saved credential", function () {
    expect(res.body.credential.source).to.equal("");
  });
}
